// vi: ts=4 sw=4 ff=unix fenc=utf-8
// リソーススクリプト：アイコンとバージョン情報を実行ファイルに埋め込む

#include <winver.h>
#include "resource.h"
// APP_VERSION_NUM（カンマ区切り 4 数値）と APP_VERSION_STR（表示用文字列）を定義する
// ビルド時生成ヘッダ。rc.exe には生成先を /I で与える。
// rc.exe の /d では文字列リテラルを渡せないため、ヘッダ生成方式を採る。
#include "version.rc.h"

IDI_APP_ICON    ICON    "app.ico"

// FileDescription と ProductName が空の実行ファイルは、Windows のアプリ一覧 UI（音量ミキサー、
// ファイアウォールの許可アプリ等）が表示名を exe の親フォルダ名で代替する。
// Scoop 配置ではフォルダ名がバージョン番号のため、アプリ名がバージョン番号として表示される。
VS_VERSION_INFO VERSIONINFO
FILEVERSION    APP_VERSION_NUM
PRODUCTVERSION APP_VERSION_NUM
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0x0L
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // 0409 = 米国英語、04B0 = Unicode。日本語環境でも文字化けせず読める組み合わせである
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "aviscaerulea"
            VALUE "FileDescription",  "gcalntfy - Google Calendar 通知"
            VALUE "FileVersion",      APP_VERSION_STR
            VALUE "InternalName",     "gcalntfy"
            VALUE "LegalCopyright",   "Copyright (c) 2026 aviscaerulea"
            VALUE "OriginalFilename", "gcalntfy.exe"
            VALUE "ProductName",      "gcalntfy"
            VALUE "ProductVersion",   APP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 0x04B0
    END
END
